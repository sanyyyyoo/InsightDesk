# Copy this file to .env and fill in your team's values.
# .env is git-ignored; never commit real keys.

# --- Supabase (database + auth) ---
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=<your-supabase-key>
# Only for legacy projects that sign login tokens with HS256.
# Projects using JWT signing keys (ES256/RS256) need nothing here.
# SUPABASE_JWT_SECRET=<legacy-jwt-secret>

# --- API access ---
# Require an admin login (app_metadata.role = "admin") on /dashboard and /chat.
# Keep false while the Streamlit dashboard is used (it sends no token).
ADMIN_AUTH_REQUIRED=false
# Browser origins allowed to call the API (React dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Pinecone (vector search; index must be dimension 384, metric cosine) ---
PINECONE_API_KEY=<your-pinecone-key>
PINECONE_INDEX=<your-index-name>

# --- LLM provider: "groq" (cloud) or "local" (Ollama) ---
LLM_PROVIDER=groq
GROQ_API_KEY=<your-groq-key>
GROQ_MODEL=openai/gpt-oss-120b
# LOCAL_LLM_MODEL=qwen3:1.7b
# LOCAL_LLM_BASE_URL=http://localhost:11434

# --- Email escalation (SMTP_PORT is required even if you never send email) ---
EMAIL_ID=<sender@gmail.com>
EMAIL_PASSWORD=<gmail-app-password>
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- Pipeline switches (defaults shown; all optional) ---
# REJOIN_ENABLED=1                 # case re-joining every REJOIN_INTERVAL_HOURS (0 = off)
# REJOIN_INTERVAL_HOURS=6          # maintenance interval: boilerplate list, re-joining, topic upkeep
# UNASSIGNED_SPIKES=1              # vague-complaint alarm per product (0 = off)
# LLM_CACHE=1                      # cache judge and re-joining decisions (0 = always call the LLM)
# LLM_CACHE_PATH=backend/data/llm_decisions.jsonl
# BOILERPLATE_PATH=backend/data/boilerplate_segments.json
# BOILERPLATE_MAX_COMPLAINTS=2000  # most recent complaints scanned for boilerplate
