# Copy this file to .env and fill in your team's values.
# .env is git-ignored; never commit real keys.

# --- Supabase (database) ---
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=<your-supabase-key>

# --- Pinecone (vector search; index must be dimension 384, metric cosine) ---
PINECONE_API_KEY=<your-pinecone-key>
PINECONE_INDEX=<your-index-name>

# --- LLM provider: "groq" (cloud) or "local" (Ollama) ---
LLM_PROVIDER=groq
GROQ_API_KEY=<your-groq-key>
GROQ_MODEL=openai/gpt-oss-120b
# LOCAL_LLM_MODEL=qwen3:1.7b
# LOCAL_LLM_BASE_URL=http://localhost:11434

# --- Email escalation (SMTP_PORT is required even if you never send email) ---
EMAIL_ID=<sender@gmail.com>
EMAIL_PASSWORD=<gmail-app-password>
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
