# Copy to .env.local and fill in. Only PUBLIC values belong here:
# Vite ships every VITE_* variable to the browser. Never put the backend's
# secrets (Pinecone, Groq, email password, service-role key) in web/.

# FastAPI backend
VITE_API_URL=http://127.0.0.1:8000

# Supabase project (Settings -> API). Use the ANON / publishable key,
# never the service-role / secret key.
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# mock   = built-in sample data only (no backend, no Supabase)
# hybrid = live READ-ONLY dashboards; complaint submission, RCA generation,
#          escalation and v2 features stay on sample data
# live   = everything live
VITE_DATA_MODE=hybrid

# hybrid only: true lets the write actions hit the real backend
# (submission writes Supabase + Pinecone, RCA writes case_rca, escalation sends email)
VITE_ENABLE_WRITES=false

# mock = simulated sign-in (no Supabase accounts touched); supabase = real sign-in
VITE_AUTH_MODE=mock

# true  = the admin portal requires app_metadata.role = "admin" (production)
# false = any signed-in user may open the admin portal (local dev only)
VITE_REQUIRE_ADMIN_ROLE=true
