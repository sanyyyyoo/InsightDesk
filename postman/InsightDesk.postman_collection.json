{
  "info": {
    "name": "InsightDesk API tests",
    "description": "Functional API tests for the InsightDesk backend (FastAPI). Run against a LOCAL backend connected to a TEST Supabase project and Pinecone index - never production. Run the folders in order: later requests use the case created in folder 2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "userId",
      "value": "postman-user-1"
    },
    {
      "key": "userId2",
      "value": "postman-user-2"
    },
    {
      "key": "product",
      "value": "PostmanTestApp"
    },
    {
      "key": "complaintText",
      "value": "Postman test: the app shows invalid credentials when I log in with the correct password"
    },
    {
      "key": "caseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "API is running",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON body\", () => pm.response.to.be.json);",
                  "pm.test(\"running message\", () => pm.expect(pm.response.json().message).to.include(\"running\"));",
                  "pm.test(\"responds within 5 s\", () => pm.expect(pm.response.responseTime).to.be.below(5000));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Ingest complaints (/analyze)",
      "item": [
        {
          "name": "New complaint creates or joins a case",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analyze",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analyze"
              ]
            },
            "description": "Ingests one complaint; stores the returned case_id for the next requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"complaint_text\": \"{{complaintText}}\",\n  \"user_id\": \"{{userId}}\",\n  \"rating\": 1,\n  \"source\": \"postman\",\n  \"product\": \"{{product}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON body\", () => pm.response.to.be.json);",
                  "const r = pm.response.json();",
                  "pm.test(\"has complaint_id, case_id, dedup_route, is_duplicate\", () => {",
                  "  [\"complaint_id\", \"case_id\", \"dedup_route\", \"is_duplicate\"].forEach(k => pm.expect(r).to.have.property(k));",
                  "});",
                  "pm.test(\"dedup_route is a known route\", () =>",
                  "  pm.expect([\"auto_merge\", \"judge_merge\", \"new_empty\", \"new_low\", \"new_judge\", \"vague\", \"judge_failed\"]).to.include(r.dedup_route));",
                  "pm.collectionVariables.set(\"caseId\", r.case_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Same complaint again joins the same case (duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analyze",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analyze"
              ]
            },
            "description": "An identical complaint from another user must be merged (above the auto-merge threshold).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"complaint_text\": \"{{complaintText}}\",\n  \"user_id\": \"{{userId2}}\",\n  \"rating\": 1,\n  \"source\": \"postman\",\n  \"product\": \"{{product}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON body\", () => pm.response.to.be.json);",
                  "const r = pm.response.json();",
                  "pm.test(\"marked as duplicate\", () => pm.expect(r.is_duplicate).to.eql(true));",
                  "pm.test(\"same case as the first complaint\", () => pm.expect(String(r.case_id)).to.eql(String(pm.collectionVariables.get(\"caseId\"))));"
                ]
              }
            }
          ]
        },
