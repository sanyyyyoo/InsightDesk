    {
      "name": "6. Escalation and RCA",
      "item": [
        {
          "name": "Escalating a non-eligible case -> 409 with the policy",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/cases/{{caseId}}/escalate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "cases",
                "{{caseId}}",
                "escalate"
              ]
            },
            "description": "Never sends an email: the case is not eligible. A forced escalation (force=true) is deliberately NOT included because it sends a real email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// a fresh case with 2 reports and no spike does not meet the policy (>= 3 reports or a spike)",
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"detail explains eligibility\", () => {",
                  "  const d = pm.response.json().detail; pm.expect(d.eligible).to.eql(false); pm.expect(d.message).to.include(\"force=true\"); });"
                ]
              }
            }
